# Production Environment Variables for SyncWrite
NODE_ENV=production
PORT=3001
CLIENT_URL=https://syncwrite.yourdomain.com

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_hex_string_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_64_hex_string_for_refresh_tokens

JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Storage directories
DATA_DIR=../data
PROJECTS_DIR=../projects
